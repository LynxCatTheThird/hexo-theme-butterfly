//- Modified in this fork.
- let defaultComment = theme.comments.use[0]
hr.custom-hr
#post-comment
  .comment-head
    .comment-headline
      i.fas.fa-comments.fa-fw
      span= ' ' + _p('comment')

    if theme.comments.use.length > 1
      .comment-switch
        if theme.comments.text
          span.first-comment=defaultComment
        button#switch-btn(type='button' role='switch' aria-checked='false' aria-label=theme.comments.use.join(' / '))
        if theme.comments.text
          span.second-comment=theme.comments.use[1]


  .comment-wrap
    each name in theme.comments.use
      div
        case name
          when 'Twikoo'
            #twikoo-wrap
          when 'Waline'
            #waline-wrap
          when 'Artalk'
            #artalk-wrap
