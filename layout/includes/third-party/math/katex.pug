//- Modified in this fork.
script.
  (() => {
    const loadKatex = async () => {
      const article = document.getElementById('article-container')
      if (!article || !article.querySelector('.katex')) return
      try {
        await btf.getCSS('!{url_for(theme.asset.katex)}')
        if (!{theme.math.katex.copy_tex}) await btf.getScript('!{url_for(theme.asset.katex_copytex)}')
      } catch (error) {
        console.error('[katex]', error)
      }
      if (article.isConnected) article.querySelectorAll('.katex').forEach(el => el.classList.add('katex-show'))
    }
    btf.addPageFn('encrypt', loadKatex, 'katex')
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadKatex, { once: true })
    else loadKatex()
  })()
