//- Modified in this fork.
- const mathjax = theme.math.mathjax
script.
  (() => {
    const loadMathjax = async () => {
      const article = document.getElementById('article-container')
      if (!article || article.querySelector('.hbe-container')) return
      article.querySelectorAll('script[type^="math/tex"]').forEach(el => {
        const display = /mode=display/.test(el.type)
        const node = document.createElement(display ? 'div' : 'span')
        node.textContent = display ? `$$${el.textContent}$$` : `$${el.textContent}$`
        el.replaceWith(node)
      })
      if (!window.mathjaxReady) {
        window.MathJax = {
          loader: { load: ['[tex]/mhchem', 'ui/lazy'], ...!{JSON.stringify(mathjax.loader || {}).replace(/</g, '\\u003c')} },
          output: !{JSON.stringify(mathjax.output || {}).replace(/</g, '\\u003c')},
          tex: {
            inlineMath: [['$', '$'], ['\\(', '\\)']],
            tags: '!{mathjax.tags}',
            packages: { '[+]': ['mhchem'] },
            ...!{JSON.stringify(mathjax.tex || {}).replace(/</g, '\\u003c')}
          },
          chtml: !{JSON.stringify(mathjax.chtml).replace(/</g, '\\u003c')},
          options: {
            enableMenu: !{mathjax.enableMenu},
            menuOptions: { settings: { enrich: false } },
            ...!{JSON.stringify(mathjax.options).replace(/</g, '\\u003c')}
          },
          startup: { typeset: false }
        }
        window.mathjaxReady = btf.getScript('!{url_for(theme.asset.mathjax)}')
          .then(() => MathJax.startup.promise)
          .catch(error => { delete window.mathjaxReady; throw error })
      }
      try {
        await window.mathjaxReady
        if (!article.isConnected) return
        MathJax.typesetClear([article])
        await MathJax.typesetPromise([article])
      } catch (error) {
        console.error('[mathjax]', error)
      }
    }
    btf.addGlobalFn('pageCleanup', () => {
      if (typeof window.MathJax?.typesetClear === 'function') MathJax.typesetClear()
    }, 'mathjax')
    btf.addPageFn('encrypt', loadMathjax, 'mathjax')
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadMathjax, { once: true })
    else loadMathjax()
  })()
